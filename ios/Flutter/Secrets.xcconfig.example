// 1) Copy this file to Secrets.xcconfig (same folder). That path is gitignored.
//    cp ios/Flutter/Secrets.xcconfig.example ios/Flutter/Secrets.xcconfig
//
// 2) Set DEVELOPMENT_TEAM to your 10-character Apple Team ID:
//    - Xcode → Settings → Accounts → select your team → Team ID, or
//    - https://developer.apple.com/account → Membership → Team ID
//
// 3) In Xcode, open ios/Runner.xcworkspace:
//    - Select Runner target → Signing & Capabilities
//    - Team: your team (or match the ID above)
//    - If "com.example" bundle ID is taken, set a unique one (e.g. sa.yourname.pilates)
//
// 4) flutter run -d <your-iphone>
//
// Tip: The iOS Simulator does not need a Development Team for most builds:
//    flutter run -d <simulator-id>

DEVELOPMENT_TEAM = YOUR_TEAM_ID
